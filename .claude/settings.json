{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sage-hook --runtime claude --hook post-tool-logger",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sage-hook --runtime claude --hook generated-artifact-write-guard",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sage-hook --runtime claude --hook pre-implementation-gate",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sage-hook --runtime claude --hook pre-phase4-checklist-gate",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sage-hook --runtime claude --hook session-start-snapshot",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sage-hook --runtime claude --hook stop-compliance-report",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sage-hook --runtime claude --hook capture-declared-risk",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
