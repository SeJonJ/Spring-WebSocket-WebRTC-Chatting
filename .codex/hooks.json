{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "sage-hook --runtime codex --hook post-tool-logger",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "sage-hook --runtime codex --hook generated-artifact-write-guard",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sage-hook --runtime codex --hook pre-implementation-gate",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sage-hook --runtime codex --hook pre-phase4-checklist-gate",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sage-hook --runtime codex --hook session-start-snapshot",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sage-hook --runtime codex --hook stop-compliance-report",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sage-hook --runtime codex --hook capture-declared-risk",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
